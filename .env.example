# ── ตัวอย่าง environment สำหรับ production (docker-compose.prod.yml) ──
# คัดลอกเป็น .env แล้วเปลี่ยนค่าจริง — ห้าม commit .env เข้า repo

# ─── PostgreSQL ───
POSTGRES_USER=coffee
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสผ่านที่คาดเดายาก
POSTGRES_DB=coffee_pos

# ─── JWT ───
# สร้างค่าสุ่ม: openssl rand -hex 32
JWT_SECRET=เปลี่ยนเป็นค่าสุ่มยาวอย่างน้อย64ตัวอักษร
JWT_EXPIRES_IN=12h

# ─── Admin คนแรก (สร้างอัตโนมัติตอน backend สตาร์ทครั้งแรก) ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=เปลี่ยนเป็นรหัสผ่านadminที่ปลอดภัย

# ─── ที่อยู่หน้าเว็บ (ใช้กับ CORS) ───
# ยังไม่มีโดเมน → ใส่ IP ของ VPS เช่น http://203.0.113.10
# มีโดเมนแล้ว → http://your-domain.com
CLIENT_ORIGIN=http://ไอพีหรือโดเมนของคุณ
