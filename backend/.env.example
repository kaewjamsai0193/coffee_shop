# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าจริง (ห้าม commit .env)
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coffee_pos

# JWT — สร้างค่าสุ่ม: openssl rand -hex 32
JWT_SECRET=ใส่ค่าสุ่มยาวๆของคุณเอง
JWT_EXPIRES_IN=12h

# ใช้ตอนรัน npm run create-admin เพื่อสร้าง admin คนแรก
ADMIN_USERNAME=admin
ADMIN_PASSWORD=เปลี่ยนเป็นรหัสผ่านที่ปลอดภัย

# origin ของ frontend (สำหรับ CORS)
CLIENT_ORIGIN=http://localhost:5173
